# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (these credentials are shared with the Compose service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=essay
POSTGRES_PASSWORD=YOUR_NEW_PROJECT_PASSWORD
POSTGRES_DB=essay_eval

# JWT (Phase 2 access tokens; set JWT_SECRET_KEY to at least 32 random bytes)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true when serving over HTTPS; keep false for local HTTP development.
REFRESH_COOKIE_SECURE=false
# Reserved for the later refresh-token flow.
JWT_REFRESH_SECRET_KEY=

# Local essay storage (created in Phase 4)
FILE_STORAGE_DIR=./data/files

# Redis + ARQ (Compose service redis; worker starts in Phase 7)
REDIS_URL=redis://localhost:6379/0

# Frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure exactly one provider. Evaluation jobs (Phase 6+) fail closed if missing.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
MAX_EVALUATION_CHARS=30000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use these instead if LLM_PROVIDER=gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=text-embedding-004

MAX_UPLOAD_MB=10
MAX_EXTRACTED_CHARS=500000

# Optional scanned/handwritten PDF OCR (TrOCR)
OCR_ENABLED=false
OCR_PROVIDER=trocr
OCR_MODEL_ID=microsoft/trocr-base-handwritten
OCR_DEVICE=cpu
